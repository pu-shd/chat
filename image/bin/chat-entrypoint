#!/bin/bash
# chat-entrypoint — wraps docker-zulip's /sbin/entrypoint.sh.
#
#   app:run | app:init | app:backup | ...   passed straight through
#   chat:manage <subcommand> [args]         one-shot management (the -mgmt job)
#
# Before handing over it writes the chat.<dept>/<slug> redirects into nginx's
# app.d include. Puppet (run by the upstream entrypoint) manages named files in
# app.d but does not purge the directory, so ours survives it.
set -euo pipefail

REDIRECTS_CONF="${CHAT_REDIRECTS_CONF:-/etc/nginx/zulip-include/app.d/chat-redirects.conf}"
# Per-client-IP limits: zones at http level (Zulip's nginx.conf includes conf.d), the
# limit_req directives at server level (app.d), inherited by every Zulip location.
RATE_HTTP_CONF="${CHAT_RATE_HTTP_CONF:-/etc/nginx/conf.d/chat-rate-limits.conf}"
RATE_SERVER_CONF="${CHAT_RATE_SERVER_CONF:-/etc/nginx/zulip-include/app.d/chat-rate-limits.conf}"
# Themes: which host gets which stylesheet (http-level map), and the injection itself.
THEMES_DIR="${CHAT_THEMES_DIR:-/usr/local/share/chat-themes}"
THEME_HTTP_CONF="${CHAT_THEME_HTTP_CONF:-/etc/nginx/conf.d/chat-themes.conf}"
THEME_SERVER_CONF="${CHAT_THEME_SERVER_CONF:-/etc/nginx/zulip-include/app.d/chat-themes.conf}"

write_redirects() {
    if [[ -z "${CHAT_REDIRECTS_B64:-}" ]]; then
        rm -f "$REDIRECTS_CONF"
        return 0
    fi
    mkdir -p "$(dirname "$REDIRECTS_CONF")"
    local tmp
    tmp="$(mktemp)"
    if ! base64 -d <<<"$CHAT_REDIRECTS_B64" >"$tmp"; then
        echo "chat-entrypoint: ERROR: CHAT_REDIRECTS_B64 is not valid base64; redirects disabled" >&2
        rm -f "$tmp" "$REDIRECTS_CONF"
        return 0
    fi
    # Only `location ... { return 302 https://...; }` lines and comments are allowed:
    # this file is spliced into the public server block.
    if grep -vE '^(#.*|location ~ \^/[A-Za-z0-9\\_-]+/\?\$ \{ return 302 https://[A-Za-z0-9.-]+/; \})?$' "$tmp" >/dev/null; then
        echo "chat-entrypoint: ERROR: CHAT_REDIRECTS_B64 contains lines other than redirects; refusing it" >&2
        rm -f "$tmp" "$REDIRECTS_CONF"
        return 0
    fi
    install -m 0644 "$tmp" "$REDIRECTS_CONF"
    rm -f "$tmp"
    echo "chat-entrypoint: installed $(grep -c '^location' "$REDIRECTS_CONF" || true) redirect(s)"
}

write_rate_limits() {
    rm -f "$RATE_HTTP_CONF" "$RATE_SERVER_CONF"
    [[ -n "${CHAT_RATE_LIMITS:-}" ]] || { echo "chat-entrypoint: rate limits off"; return 0; }
    # Parameters, never nginx text: auth:<n>r/m:<burst>,api:<n>r/s:<burst>
    local re='^auth:([0-9]{1,5})r/(s|m):([0-9]{1,6}),api:([0-9]{1,5})r/(s|m):([0-9]{1,6})$'
    if [[ ! "$CHAT_RATE_LIMITS" =~ $re ]]; then
        echo "chat-entrypoint: ERROR: CHAT_RATE_LIMITS '$CHAT_RATE_LIMITS' is malformed; rate limits OFF" >&2
        return 0
    fi
    local auth_rate="${BASH_REMATCH[1]}r/${BASH_REMATCH[2]}" auth_burst="${BASH_REMATCH[3]}"
    local api_rate="${BASH_REMATCH[4]}r/${BASH_REMATCH[5]}" api_burst="${BASH_REMATCH[6]}"
    local cidr_re='^((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])/([0-9]|[12][0-9]|3[0-2])$'
    local exempt="" c
    for c in ${CHAT_RATE_LIMIT_EXEMPT:-}; do
        if [[ ! "$c" =~ $cidr_re ]]; then
            echo "chat-entrypoint: ERROR: exempt range '$c' is not an IPv4 CIDR; rate limits OFF" >&2
            return 0
        fi
        exempt+="    $c 1;"$'\n'
    done
    mkdir -p "$(dirname "$RATE_HTTP_CONF")" "$(dirname "$RATE_SERVER_CONF")"
    cat >"$RATE_HTTP_CONF" <<NGINX
# GENERATED by chat-entrypoint from CHAT_RATE_LIMITS / CHAT_RATE_LIMIT_EXEMPT.
# \$remote_addr is the real client: Zulip's realip trusts X-Forwarded-For only from
# LOADBALANCER_IPS. An empty key is never limited.
geo \$chat_rl_exempt {
    default 0;
${exempt}}
map \$uri \$chat_rl_class {
    default "";
    ~^/(accounts/(login|register|password|find|new|deactivated|do_confirm|go)|register/|login/|complete/|api/v1/(fetch_api_key|dev_fetch_api_key|jwt/)) auth;
    ~^/(api|json)/ api;
}
map "\$chat_rl_exempt:\$chat_rl_class" \$chat_rl_auth_key { "0:auth" \$binary_remote_addr; default ""; }
map "\$chat_rl_exempt:\$chat_rl_class" \$chat_rl_api_key { "0:api" \$binary_remote_addr; default ""; }
limit_req_zone \$chat_rl_auth_key zone=chat_auth:10m rate=${auth_rate};
limit_req_zone \$chat_rl_api_key zone=chat_api:20m rate=${api_rate};
limit_req_status 429;
limit_req_log_level warn;
NGINX
    cat >"$RATE_SERVER_CONF" <<NGINX
# GENERATED by chat-entrypoint (see ${RATE_HTTP_CONF}).
limit_req zone=chat_auth burst=${auth_burst} nodelay;
limit_req zone=chat_api burst=${api_burst} nodelay;
NGINX
    echo "chat-entrypoint: rate limits auth ${auth_rate} (burst ${auth_burst}), api ${api_rate} (burst ${api_burst}), $(wc -l <<<"${exempt%$'\n'}" | tr -d ' ') exempt range(s)"
}

write_themes() {
    rm -f "$THEME_HTTP_CONF" "$THEME_SERVER_CONF"
    [[ -n "${CHAT_THEMES:-}" ]] || { echo "chat-entrypoint: no themes (Zulip default look)"; return 0; }
    # Parameters, never nginx text: "<host>=<theme> ...", each theme baked into the image.
    local host_re='^[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?$' theme_re='^[a-z0-9][a-z0-9-]{0,39}$'
    local entry host theme map="" n=0 hash
    for entry in $CHAT_THEMES; do
        host="${entry%%=*}"; theme="${entry#*=}"
        if [[ "$entry" != *=* || ! "$host" =~ $host_re || ! "$theme" =~ $theme_re ]]; then
            echo "chat-entrypoint: ERROR: theme entry '$entry' is malformed; themes OFF" >&2
            return 0
        fi
        if [[ ! -f "$THEMES_DIR/$theme/theme.css" ]]; then
            echo "chat-entrypoint: ERROR: theme '$theme' is not in this image; themes OFF" >&2
            return 0
        fi
        hash="$(sha256sum "$THEMES_DIR/$theme/theme.css" | cut -c1-12)"
        map+="    $host '<link rel=\"stylesheet\" href=\"/chat-theme/$theme/theme.css?v=$hash\">';"$'\n'
        n=$(( n + 1 ))
    done
    mkdir -p "$(dirname "$THEME_HTTP_CONF")" "$(dirname "$THEME_SERVER_CONF")"
    cat >"$THEME_HTTP_CONF" <<NGINX
# GENERATED by chat-entrypoint from CHAT_THEMES. Hosts not listed keep Zulip's look.
map \$host \$chat_theme_link {
    default "";
${map}}
NGINX
    cat >"$THEME_SERVER_CONF" <<NGINX
# GENERATED by chat-entrypoint (see ${THEME_HTTP_CONF}).
location /chat-theme/ {
    alias ${THEMES_DIR}/;
    include /etc/nginx/zulip-include/headers;
    add_header Cache-Control "public, max-age=86400" always;
}
sub_filter '</head>' '\$chat_theme_link</head>';
sub_filter_once on;
NGINX
    echo "chat-entrypoint: theme(s) for $n host(s)"
}

[[ "${CHAT_ENTRYPOINT_TEST:-}" == 1 ]] && { write_redirects; write_rate_limits; write_themes; exit 0; }

case "${1:-app:run}" in
    chat:manage)
        shift
        exec /usr/local/bin/chat-manage "$@"
        ;;
    *)
        write_redirects
        write_rate_limits
        write_themes
        exec /sbin/entrypoint.sh "$@"
        ;;
esac
